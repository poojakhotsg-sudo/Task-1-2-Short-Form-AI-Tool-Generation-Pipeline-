# Copy to .env and fill in. Never put passwords or card details in this file.
GROQ_API_KEY=your_groq_api_key_here
# Drive folder ID of the shared "AI Tools" folder (from its URL)
DRIVE_FOLDER_ID=

# (Optional) Remote browser websocket for zero-RAM Render execution (e.g. wss://chrome.browserless.io?token=...)
# BROWSER_WS_URL=

# (Optional) Supabase job persistence across container restarts
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-or-service-role-key
# SUPABASE_TABLE=jobs

