# Authenticates the Inngest-to-worker HTTP dispatch — must match
# web-next's WORKER_AUTH_TOKEN exactly.
WORKER_AUTH_TOKEN=

# Storage. OPEN QUESTION (see src/lib/storage.ts's comment): using the
# service-role key here reintroduces the "don't hand the worker a
# service-role-level credential" problem migration 0003 solved for
# Postgres — Supabase Storage access control is a separate mechanism
# (storage.objects RLS / bucket policies) that hasn't been scoped down
# yet. Works today; revisit before this goes to production.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_PRIVATE_BUCKET=

PORT=8080

# describe_clips vision captioning (PIPE-03). Claude preferred; Groq is
# the fallback when ANTHROPIC_API_KEY isn't set.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROK_API_KEY=
# No default on purpose — confirm Groq's current vision-capable model
# name before setting this (see src/services/visionCaption.ts's comment
# on why one isn't hardcoded here).
GROQ_VISION_MODEL=
